AMAZON_AFFILIATE_TAG=your-tag-20

# Optional: only needed if you have a separate UK Associates account, to
# generate amazon.co.uk affiliate links alongside amazon.com ones
AMAZON_AFFILIATE_TAG_UK=your-uk-tag-21

# From https://www.canopyapi.co/ (free tier: 100 requests/month)
CANOPY_API_KEY=your-canopy-api-key

# From the Pinterest developer app you registered
PINTEREST_APP_ID=your-app-id
PINTEREST_APP_SECRET=your-app-secret
PINTEREST_REDIRECT_URI=http://localhost:8080/callback

# Sandbox token from https://developers.pinterest.com/docs/getting-started/set-up-authentication-and-authorization/#choose-scopes
PINTEREST_ACCESS_TOKEN=your-sandbox-access-token

# Sandbox by default; switch to https://api.pinterest.com/v5 for production
PINTEREST_API_BASE_URL=https://api-sandbox.pinterest.com/v5

# From https://zernio.com/ — third-party posting route while PINTEREST_ACCESS_TOKEN
# above is still trial-access only. Requires connecting Pinterest via their dashboard first.
ZERNIO_API_KEY=your-zernio-api-key

# From https://console.anthropic.com/ — used to auto-generate SEO pin titles/descriptions/hashtags
ANTHROPIC_API_KEY=your-anthropic-api-key

# Which Amazon marketplace product discovery searches (UK, US, DE, ...).
# Optional — defaults to UK. Affiliate links are still built for every region
# you hold a tag for, whichever store the search ran against.
DISCOVERY_DOMAIN=UK
